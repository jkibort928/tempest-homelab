[Unit]
Description=SpotDL Web Interface
After=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Container]
ContainerName=spotdl
Image=spotdl-local.build
AutoUpdate=local

UserNS=keep-id
User=1000:1000

Memory=1024M

Volume=%h/quadlets/dockerfiles:/app:Z
Volume=/mnt/storage/music:/music:Z
Volume=/etc/localtime:/etc/localtime:ro

Network=media-internal.network
PublishPort=8800:8000

[Install]
WantedBy=default.target

[Service]
CPUWeight=50
Restart=on-failure
RestartSec=5
