[Unit]
Description=SpotDL Web Interface
After=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Container]
ContainerName=spotdl
Image=spotdl-local.build
AutoUpdate=local

UserNS=keep-id
User=1000:1000

Memory=1024M

Environment=PYTHONDONTWRITEBYTECODE=1

Volume=%h/quadlets/dockerfiles/spotdl_server.py:/app/spotdl_server.py:z
Volume=%h/quadlets/dockerfiles/music-spot-initPlaylist.py:/app/music-spot-initPlaylist.py:z
Volume=%h/srv/@music/config/spotdl:/config:Z
Volume=/mnt/storage/music:/music
Volume=/etc/localtime:/etc/localtime:ro

Network=media-internal.network
PublishPort=8800:8000

[Install]
WantedBy=default.target

[Service]
CPUWeight=50
Restart=on-failure
RestartSec=5
